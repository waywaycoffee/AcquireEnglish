# coturn for AcquireEnglish LiveTalking WebRTC (phone ↔ GPU via ECS public IP).
# Copy to /etc/turnserver.conf and set user/password (do not commit secrets).
#
# Aliyun security group must allow:
#   UDP/TCP 3478
#   UDP 49152-49200 (relay)

listening-port=3478
tls-listening-port=5349
fingerprint
lt-cred-mech
realm=acquireenglish.curlhairai.com

# Replace with ECS public IP (and optional private IP):
# external-ip=PUBLIC_IP/PRIVATE_IP
external-ip=8.163.45.100/172.25.164.131

# Static user (also set TURN_USERNAME / TURN_PASSWORD on oral-coach + LiveTalking):
user=acquire:CHANGE_ME_TURN_PASSWORD

min-port=49152
max-port=49200
no-cli
no-tls
no-dtls
no-multicast-peers
simple-log
verbose
