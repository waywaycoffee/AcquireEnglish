SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local/dev default (SQLite). Production: postgresql+asyncpg://USER:PASS@127.0.0.1:5432/acquireenglish
DATABASE_URL=sqlite+aiosqlite:///./acquire_english.db
CORS_ORIGINS=https://acquireenglish.curlhairai.com,http://localhost:5173
MEDIA_PUBLIC_BASE=https://acquireenglish.curlhairai.com
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash-filetrans
BILIBILI_COOKIE=

# --- Auth: SMS ---
# Dev: AUTH_SMS_MOCK=true (fixed code, returned as debug_code)
# Prod: AUTH_SMS_MOCK=false + Aliyun Dysmsapi OR AUTH_SMS_WEBHOOK_URL
AUTH_SMS_MOCK=true
AUTH_SMS_MOCK_CODE=123456
AUTH_SMS_CODE_TTL_SECONDS=300
# AUTH_SMS_WEBHOOK_URL=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# --- Auth: Email registration code ---
# Dev: AUTH_EMAIL_MOCK=true (fixed code, returned as debug_code)
# Prod: AUTH_EMAIL_MOCK=false + SMTP_* (or AUTH_EMAIL_WEBHOOK_URL)
AUTH_EMAIL_MOCK=true
AUTH_EMAIL_MOCK_CODE=123456
AUTH_EMAIL_CODE_TTL_SECONDS=300
# AUTH_EMAIL_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_SSL=true
SMTP_USE_TLS=false

# --- Auth: WeChat mobile OAuth ---
# Dev: AUTH_WECHAT_MOCK=true (any code → stable mock openid)
# Prod: AUTH_WECHAT_MOCK=false + WECHAT_APP_ID/SECRET from open.weixin.qq.com
AUTH_WECHAT_MOCK=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# --- WeChat Pay (App 支付, APIv3) ---
# Beyond Open Platform AppID/Secret you also need a 商户号 + APIv3 credentials.
WECHAT_MCH_ID=
WECHAT_MCH_SERIAL_NO=
WECHAT_MCH_API_V3_KEY=
# PEM body (-----BEGIN PRIVATE KEY-----...) or absolute path to apiclient_key.pem
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PAY_NOTIFY_URL=https://acquireenglish.curlhairai.com/api/assets/wechat/notify

# LiveKit (same keys as tools/digital_human_coach/.env on the GPU worker)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Tencent Cloud SOE; enable the service in Tencent Cloud before configuring.
# Server-side only: never put these credentials in Flutter or Git.
TENCENT_SOE_SECRET_ID=
TENCENT_SOE_SECRET_KEY=
