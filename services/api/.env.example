SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# Local/dev default (SQLite). Production: postgresql+asyncpg://USER:PASS@127.0.0.1:5432/acquireenglish
DATABASE_URL=sqlite+aiosqlite:///./acquire_english.db
CORS_ORIGINS=https://acquireenglish.curlhairai.com,http://localhost:5173
MEDIA_PUBLIC_BASE=https://acquireenglish.curlhairai.com
DASHSCOPE_API_KEY=
ASR_MODEL=qwen3-asr-flash-filetrans
BILIBILI_COOKIE=

# --- Auth: SMS ---
# Dev: AUTH_SMS_MOCK=true (fixed code, returned as debug_code)
# Prod: AUTH_SMS_MOCK=false + Aliyun Dysmsapi OR AUTH_SMS_WEBHOOK_URL
AUTH_SMS_MOCK=true
AUTH_SMS_MOCK_CODE=123456
AUTH_SMS_CODE_TTL_SECONDS=300
# AUTH_SMS_WEBHOOK_URL=
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION=cn-hangzhou

# --- Auth: WeChat mobile OAuth ---
# Dev: AUTH_WECHAT_MOCK=true (any code → stable mock openid)
# Prod: AUTH_WECHAT_MOCK=false + WECHAT_APP_ID/SECRET from open.weixin.qq.com
AUTH_WECHAT_MOCK=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# LiveKit (same keys as tools/digital_human_coach/.env on the GPU worker)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
