# ===== LiveKit =====
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx
LIVEKIT_AGENT_NAME=acquire-oral-coach

# ===== LLM: DeepSeek (default, no OpenAI) =====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Optional OpenAI instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ===== Voice without OpenAI =====
# auto → Deepgram if DEEPGRAM_API_KEY set, else free Edge TTS
TTS_PROVIDER=auto
STT_PROVIDER=auto
EDGE_TTS_VOICE=en-US-JennyNeural
# Recommended (STT + TTS one key, free credits on signup):
# DEEPGRAM_API_KEY=

# ===== Production oral_coach + learning =====
ORAL_COACH_URL=https://acquireenglish.curlhairai.com/coach
LEARNING_API_URL=https://acquireenglish.curlhairai.com/api/learning
# LEARNING_API_BEARER=

INTERRUPTION_MODE=vad
INTERRUPTION_MIN_DURATION=0.4
FALSE_INTERRUPTION_TIMEOUT=1.5
LEARNING_DB_PATH=~/.local/share/acquire-dh-coach/learning.db
