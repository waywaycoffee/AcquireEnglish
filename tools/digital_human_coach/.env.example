# ===== LiveKit (required for agent) =====
# From https://cloud.livekit.io → Project → Settings → Keys
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=xxxxxxxx
LIVEKIT_AGENT_NAME=acquire-oral-coach

# ===== Wire to production oral_coach + learning =====
ORAL_COACH_URL=https://acquireenglish.curlhairai.com/coach
LEARNING_API_URL=https://acquireenglish.curlhairai.com/api/learning
# Optional JWT so turns persist under your account:
# LEARNING_API_BEARER=

# ===== Agent speech (cloud; no GPU needed) =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_VOICE=alloy

# ===== Optional: reuse oral_coach local providers later =====
ORAL_COACH_PROVIDERS=1
ASR_PROVIDER=mock
PRON_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock
AVATAR_PROVIDER=none
LIVETALKING_URL=http://127.0.0.1:8010

# ===== Interruption (VAD barge-in) =====
INTERRUPTION_MODE=vad
INTERRUPTION_MIN_DURATION=0.4
FALSE_INTERRUPTION_TIMEOUT=1.5

LEARNING_DB_PATH=~/.local/share/acquire-dh-coach/learning.db
