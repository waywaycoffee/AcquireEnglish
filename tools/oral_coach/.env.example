ORAL_COACH_HOST=0.0.0.0
ORAL_COACH_PORT=8770
ORAL_COACH_ALLOW_LAN=true
ORAL_COACH_DATA_DIR=~/.local/share/acquire-oral-coach

# mock | whisperx | deepgram
ASR_PROVIDER=mock
DEEPGRAM_API_KEY=
WHISPERX_MODEL=base.en

# simple | phoneme | http | wav2vec2 | mock
PRON_PROVIDER=simple

# mock | openai | deepseek | ollama
LLM_PROVIDER=mock
# DeepSeek (OpenAI-compatible) — preferred over OpenAI:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# mock | xtts | fishspeech | edge
TTS_PROVIDER=mock
# qwen-audio: English via qwen-audio-3.0-tts-flash, Chinese via Edge
DASHSCOPE_API_KEY=

# none | livetalking | musetalk | liveportrait
AVATAR_PROVIDER=livetalking
# Internal probe (ECS→GPU Tailscale). Do not give this to phones.
# Local GPU-box: http://127.0.0.1:8010
LIVETALKING_URL=http://100.115.252.55:8010
# Public signaling for App (nginx). Phone needs NO Tailscale.
LIVETALKING_PUBLIC_URL=https://acquireenglish.curlhairai.com/livetalking
# coturn on ECS — required for WebRTC media across public internet
# CurlHair-style (80/443 only): TURN TLS via nginx SNI → coturn :5349
TURN_URLS=turns:turn.curlhairai.com:443?transport=tcp
TURN_USERNAME=acquire
TURN_PASSWORD=
