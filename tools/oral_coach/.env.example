ORAL_COACH_HOST=0.0.0.0
ORAL_COACH_PORT=8770
ORAL_COACH_ALLOW_LAN=true
ORAL_COACH_DATA_DIR=~/.local/share/acquire-oral-coach

# mock | whisperx | deepgram
ASR_PROVIDER=mock
DEEPGRAM_API_KEY=
WHISPERX_MODEL=base.en

# mock | wav2vec2 | phoneme
PRON_PROVIDER=mock

# mock | openai | deepseek | ollama
LLM_PROVIDER=mock
# DeepSeek (OpenAI-compatible) — preferred over OpenAI:
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# mock | xtts | fishspeech | edge
TTS_PROVIDER=mock

# none | livetalking | musetalk | liveportrait
AVATAR_PROVIDER=livetalking
LIVETALKING_URL=http://127.0.0.1:8010
