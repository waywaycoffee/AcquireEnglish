page {
  background: #0b1220;
  color: #e8eef8;
  font-size: 28rpx;
  line-height: 1.55;
  min-height: 100%;
}

.card {
  background: #121a2b;
  border: 1rpx solid #243044;
  border-radius: 24rpx;
  padding: 28rpx;
  margin: 24rpx 32rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.muted {
  color: #9fb0c7;
  font-size: 24rpx;
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border-radius: 999rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.btn-primary {
  background: #3ddc84;
  color: #04110a;
}

.btn-ghost {
  background: transparent;
  color: #93c5fd;
  border: 1rpx solid #35507a;
}

.hero {
  padding: 48rpx 32rpx 8rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.stat-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 32rpx 0;
}

.stat {
  flex: 1;
  background: #121a2b;
  border: 1rpx solid #243044;
  border-radius: 20rpx;
  padding: 20rpx;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 800;
  color: #3ddc84;
}

.stat-label {
  color: #9fb0c7;
  font-size: 22rpx;
  margin-top: 4rpx;
}
