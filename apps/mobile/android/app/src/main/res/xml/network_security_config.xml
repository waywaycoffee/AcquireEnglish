        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <!-- Prod GPU box Tailscale IP -->
        <domain includeSubdomains="true">100.115.252.55</domain>
        <!-- Tailscale MagicDNS -->
        <domain includeSubdomains="true">ts.net</domain>
        <domain includeSubdomains="true">5060ti.tailc30b42.ts.net</domain>
    </domain-config>
</network-security-config>
