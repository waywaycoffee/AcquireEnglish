# Copy to `.env` and fill values. Never commit `.env`.
# Build/run with: --dart-define-from-file=.env

# 阿里云百炼 / DashScope ASR API Key
BAILIAN_ASR_API_KEY=

# Optional aliases (first non-empty wins)
# DASHSCOPE_API_KEY=
# ASR_API_KEY=

# B 站官方字幕需要登录 Cookie（匿名接口返回空列表）
# 浏览器登录 bilibili.com → DevTools → Application → Cookies → SESSDATA
BILIBILI_SESSDATA=
# 或整段 Cookie（优先于 SESSDATA）
# BILIBILI_COOKIE=SESSDATA=xxx; bili_jct=yyy; DedeUserID=zzz
